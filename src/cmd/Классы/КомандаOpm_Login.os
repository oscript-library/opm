#Использовать logos

Перем Лог;

///////////////////////////////////////////////////////////////////////////////////////////////////
// Прикладной интерфейс

Процедура ОписаниеКоманды(Знач КомандаПриложения) Экспорт

	КомандаПриложения.Опция("token", "", "Токен доступа хаба. Без токена вход подтверждается в браузере.");
	КомандаПриложения.Опция("token-stdin", Ложь, "Прочитать токен доступа из стандартного ввода.");
	КомандаПриложения.Аргумент("HUB", "", "Адрес хаба: [схема://]хост[:порт].");

КонецПроцедуры

Процедура ВыполнитьКоманду(Знач КомандаПриложения) Экспорт

	Адрес = АдресаХаба.Адрес(КомандаПриложения.ЗначениеАргумента("HUB"));
	Токен = СокрЛП(КомандаПриложения.ЗначениеОпции("token"));

	Если КомандаПриложения.ЗначениеОпции("token-stdin") Тогда
		ВвестиСтроку(Токен);
		Токен = СокрЛП(Строка(Токен));
		Если ПустаяСтрока(Токен) Тогда
			ВызватьИсключение "Токен не прочитан из стандартного ввода";
		КонецЕсли;
	ИначеЕсли ПустаяСтрока(Токен) Тогда
		Токен = ТокенИзБраузера(Адрес);
	КонецЕсли;

	Путь = ПараметрыПриложенияOpm.СохранитьТокенХаба(Адрес.Хаб, Токен);
	Лог.Информация("Токен хаба %1 сохранён в %2", Адрес.Хаб, Путь);

КонецПроцедуры

// Открывает адрес в браузере системной командой. Адрес приходит от хаба, поэтому открывается только http(s).
//
// Параметры:
//  Адрес - Строка - адрес страницы.
//
Процедура ОткрытьВБраузере(Знач Адрес) Экспорт

	Если Не (СтрНачинаетсяС(НРег(Адрес), "https://") Или СтрНачинаетсяС(НРег(Адрес), "http://"))
		Или СтрНайти(Адрес, """") > 0 Тогда
		ВызватьИсключение СтрШаблон("Хаб прислал негодный адрес входа <%1>", Адрес);
	КонецЕсли;

	Платформа = Строка(Новый СистемнаяИнформация().ТипПлатформы);
	Если СтрНачинаетсяС(Платформа, "Windows") Тогда
		Команда = "rundll32 url.dll,FileProtocolHandler";
	ИначеЕсли СтрНачинаетсяС(Платформа, "MacOS") Тогда
		Команда = "open";
	Иначе
		Команда = "xdg-open";
	КонецЕсли;

	Попытка
		ЗапуститьПриложение(СтрШаблон("%1 ""%2""", Команда, Адрес));
	Исключение
		Лог.Отладка("Браузер не открыт: %1", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////////////////////////

// Вход по коду устройства (RFC 8628): человек подтверждает вход в браузере, opm опрашивает хаб.
Функция ТокенИзБраузера(Знач Адрес)

	Соединение = Новый HTTPСоединение(Адрес.Сервер, Адрес.Порт, , , НастройкиOpm.ПолучитьИнтернетПрокси(), 60);
	Заявка = ОтветХаба(Соединение, Адрес, "/api/v1/cli/auth/device",
		Новый Структура("client_name, scopes", "opm", "read,write"));

	Если Заявка["device_code"] = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Хаб %1 не начал вход через браузер: %2. Передайте токен опцией --token",
			Адрес.Хаб, Заявка["error_description"]);
	КонецЕсли;

	АдресВхода = Строка(Заявка["verification_uri_complete"]);
	ОткрытьВБраузере(АдресВхода);
	Сообщить(СтрШаблон("Подтвердите вход в браузере: %1", АдресВхода));
	Сообщить(СтрШаблон("Код подтверждения: %1", Заявка["user_code"]));

	Пауза = ?(Заявка["interval"] = Неопределено, 5, Заявка["interval"]);
	Пока Истина Цикл
		Приостановить(Пауза * 1000);
		Ответ = ОтветХаба(Соединение, Адрес, "/api/v1/cli/auth/device/token",
			Новый Структура("device_code", Заявка["device_code"]));
		Если Ответ["access_token"] <> Неопределено Тогда
			Возврат Ответ["access_token"];
		ИначеЕсли Ответ["error"] = "slow_down" Тогда
			Пауза = Пауза + 5;
		ИначеЕсли Ответ["error"] <> "authorization_pending" Тогда
			ВызватьИсключение СтрШаблон("Вход через браузер не выполнен: %1", Ответ["error_description"]);
		КонецЕсли;
	КонецЦикла;

КонецФункции

// Ответ хаба JSON-объектом; без error_description в ответе - описание по коду состояния.
Функция ОтветХаба(Знач Соединение, Знач Адрес, Знач Ресурс, Знач Данные)

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Запрос = Новый HTTPЗапрос(Ресурс);
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.УстановитьТелоИзСтроки(Запись.Закрыть());

	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		Лог.Отладка("Обращение к %1%2 не удалось: %3", Адрес.Хаб, Ресурс, ОписаниеОшибки());
		ВызватьИсключение СтрШаблон("Не удалось подключиться к %1", Адрес.Хаб);
	КонецПопытки;

	Тело = Ответ.ПолучитьТелоКакСтроку();
	Результат = Новый Соответствие;
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Тело);
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Лог.Отладка("Ответ %1%2 не JSON: %3", Адрес.Хаб, Ресурс, Тело);
	КонецПопытки;

	Если Результат["error_description"] = Неопределено Тогда
		Результат.Вставить("error_description", СтрШаблон("хаб ответил кодом %1", Ответ.КодСостояния));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Лог = Логирование.ПолучитьЛог("oscript.app.opm");

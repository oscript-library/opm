Перем Лог;

Перем Имя Экспорт;
Перем Сервер Экспорт;
Перем ПутьНаСервере Экспорт;
Перем Порт Экспорт;
Перем Приоритет Экспорт;
Перем Соединение;
Перем РесурсПубликацииПакетов Экспорт;
Перем Авторизация Экспорт;
Перем ДополнительныеЗаголовки Экспорт;
Перем Таймаут Экспорт;
Перем ПоследняяОшибкаСети Экспорт;

Перем ПакетыХаба;

Процедура ПриСозданииОбъекта(Знач ИмяСервера, Знач АдресСервер, Знач ВходящийПутьНаСервере = "",
		Знач ВходящийРесурсПубликацииПакетов = "", Знач ВходящийПорт = 0, Знач ВходящийПриоритет = 0,
		Знач ВходящаяАвторизация = Неопределено, Знач Заголовки = Неопределено, Знач ВходящийТаймаут = 60)
	
	Имя = ИмяСервера;
	Сервер = АдресСервер;
	ПутьНаСервере = ВходящийПутьНаСервере;
	Порт = ВходящийПорт;
	Приоритет = ВходящийПриоритет;
	РесурсПубликацииПакетов = ВходящийРесурсПубликацииПакетов;
	Авторизация = ВходящаяАвторизация;
	ДополнительныеЗаголовки = Заголовки;
	Таймаут = ВходящийТаймаут;
	ПоследняяОшибкаСети = "";

КонецПроцедуры

Функция ПолучитьИмя() Экспорт
	Возврат Имя;
КонецФункции

Функция СерверДоступен() Экспорт
	Возврат Не Соединение = Неопределено;
КонецФункции

Функция ИнициализироватьСоединение()

	Если Не Соединение = Неопределено Тогда
		Возврат Соединение;
	КонецЕсли;
	
	Настройки = НастройкиOpm.ПолучитьНастройки();
	Если Настройки.ИспользоватьПрокси Тогда
		НастройкиПрокси = НастройкиOpm.ПолучитьИнтернетПрокси();
		Соединение = Новый HTTPСоединение(Сервер, Порт, , , НастройкиПрокси, Таймаут);
	Иначе
		Соединение = Новый HTTPСоединение(Сервер, Порт, , , , Таймаут);
	КонецЕсли;
	
	Возврат Соединение;
	
КонецФункции

// Получает ресурс с сервера.
//
// Параметры:
//  ИмяРесурса - Строка - имя файла относительно "Сервер/ПутьНаСервере".
//  Спецификация - Строка, Неопределено - строка после @, уходит параметром запроса spec;
//                 пустая параметра не добавляет.
//
// Возвращаемое значение:
//  HTTPОтвет - ответ сервера; Неопределено, если запрос завершился исключением.
//
Функция ПолучитьРесурс(Знач ИмяРесурса, Знач Спецификация = Неопределено) Экспорт

	Соединение = ИнициализироватьСоединение();
	Ресурс = АдресРесурса(ИмяРесурса, Спецификация);
	Запрос = Новый HTTPЗапрос(Ресурс);
	ДобавитьЗаголовки(Запрос);
	ПоследняяОшибкаСети = "";

	Попытка
		
		Возврат Соединение.Получить(Запрос);

	Исключение

		ПоследняяОшибкаСети = СтрШаблон("Не удалось подключиться к %1", АдресДляСообщений());
		Лог.Отладка("Обращение к %1%2 не удалось: %3", Сервер, Ресурс, ОписаниеОшибки());
		Возврат Неопределено;

	КонецПопытки;

КонецФункции

// Адрес ресурса в запросе к серверу: путь с закодированными сегментами и строка запроса.
//
// Параметры:
//  ИмяРесурса - Строка - имя файла относительно "Сервер/ПутьНаСервере".
//  Спецификация - Строка, Неопределено - строка после @; пустая параметра spec не добавляет.
//  К файлу пакета добавляется параметр engine - версия установленного движка.
//
// Возвращаемое значение:
//  Строка - путь и, если есть параметры, строка запроса.
//
Функция АдресРесурса(Знач ИмяРесурса, Знач Спецификация = Неопределено) Экспорт

	Сегменты = СтрРазделить(ИмяРесурса, "/");
	Для Индекс = 0 По Сегменты.ВГраница() Цикл
		Сегменты[Индекс] = ЧастьАдреса(Сегменты[Индекс]);
	КонецЦикла;

	ПараметрыЗапроса = Новый Массив;
	Если ЗначениеЗаполнено(Спецификация) Тогда
		ПараметрыЗапроса.Добавить("spec=" + ЧастьАдреса(Спецификация));
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(ИмяРесурса, ".ospx") Тогда
		ПараметрыЗапроса.Добавить("engine=" + ЧастьАдреса(РаботаСОписаниемПакета.ВерсияДвижка()));
	КонецЕсли;

	Адрес = ПутьНаСервере + СтрСоединить(Сегменты, "/");
	Если ПараметрыЗапроса.Количество() = 0 Тогда
		Возврат Адрес;
	КонецЕсли;

	Возврат Адрес + "?" + СтрСоединить(ПараметрыЗапроса, "&");

КонецФункции

// Публикует файл пакета; отказ сервера - исключение с его сообщением.
//
// Параметры:
//  ФайлПакета - Файл - файл .ospx.
//  Канал - Строка - значение заголовка CHANNEL.
//  Токен - Строка - токен публикации; пустой - без токена.
//
// Возвращаемое значение:
//  Строка - сообщение сервера.
//
Функция ОтправитьПакет(Знач ФайлПакета, Знач Канал, Знач Токен) Экспорт

	Соединение = ИнициализироватьСоединение();
	Запрос = ЗапросПубликации(ФайлПакета, Канал, Токен);

	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		Лог.Отладка("Публикация в %1%2 не удалась: %3", Сервер, РесурсПубликацииПакетов, ОписаниеОшибки());
		ВызватьИсключение СтрШаблон("Не удалось подключиться к %1", АдресДляСообщений());
	КонецПопытки;

	Сообщение = СообщениеСервера(Ответ.ПолучитьТелоКакСтроку());
	Если Не КодУспешнойОтправки(Ответ.КодСостояния) Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;

	Возврат Сообщение;

КонецФункции

// Токен уходит заголовком OAUTH-TOKEN, если у сервера нет своей авторизации.
Функция ЗапросПубликации(Знач ФайлПакета, Знач Канал, Знач Токен)

	Запрос = Новый HTTPЗапрос(РесурсПубликацииПакетов);
	Запрос.Заголовки.Вставить("FILE-NAME", ФайлПакета.Имя);
	Запрос.Заголовки.Вставить("CHANNEL", Канал);
	Если ЗначениеЗаполнено(Токен) И Не ЗначениеЗаполнено(Авторизация) Тогда
		Запрос.Заголовки.Вставить("OAUTH-TOKEN", Токен);
	КонецЕсли;
	ДобавитьЗаголовки(Запрос);
	Запрос.УстановитьТелоИзДвоичныхДанных(Новый ДвоичныеДанные(ФайлПакета.ПолноеИмя));

	Возврат Запрос;

КонецФункции

// Хаб OpenHub отвечает JSON {"КодСостояние", "Сообщение"}: пользователю - только сообщение.
Функция СообщениеСервера(Знач ТелоОтвета)

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(ТелоОтвета);
		Ответ = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат ТелоОтвета;
	КонецПопытки;

	Если ТипЗнч(Ответ) = Тип("Соответствие") И Ответ["Сообщение"] <> Неопределено Тогда
		Возврат Ответ["Сообщение"];
	КонецЕсли;

	Возврат ТелоОтвета;

КонецФункции

Функция КодУспешнойОтправки(Знач КодСостояния)
	Возврат КодСостояния = 200 Или КодСостояния = 201 Или КодСостояния = 202;
КонецФункции

// Платформа оставляет плюс в адресе как есть, а в строке запроса он читается пробелом.
Функция ЧастьАдреса(Знач Значение)
	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Адрес сервера в сообщениях пользователю: порт указывается, только если он не стандартный.
Функция АдресДляСообщений() Экспорт

	СтандартныйПорт = ?(СтрНачинаетсяС(НРег(Сервер), "https://"), 443, 80);
	Если Порт = 0 ИЛИ Порт = СтандартныйПорт Тогда
		Возврат Сервер;
	КонецЕсли;

	Возврат СтрШаблон("%1:%2", Сервер, Формат(Порт, "ЧГ=0"));

КонецФункции

Функция ПрочитатьФайлСпискаПакетов(Текст)
	
	ТекстовыйДокумент  = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(Текст);
	КоличествоПакетовВХабе = ТекстовыйДокумент.КоличествоСтрок();
	Для НомерСтроки = 1 По КоличествоПакетовВХабе Цикл
		ИмяПакета = СокрЛП(ТекстовыйДокумент.ПолучитьСтроку(НомерСтроки));
		
		Если ПустаяСтрока(ИмяПакета) Тогда
			Продолжить;
		КонецЕсли;

		Если ПакетыХаба[ИмяПакета] = Неопределено Тогда
			ПакетыХаба.Вставить(ИмяПакета, Новый Массив);
		КонецЕсли;
		ПакетыХаба[ИмяПакета] = ""; // Тут должна быть строка версий
	КонецЦикла;

КонецФункции

Функция ПолучитьСписокПакетов(Ресурс)

	Ответ = ПолучитьРесурс(Ресурс);
	Если Ответ = Неопределено Тогда
		ВызватьИсключение ПоследняяОшибкаСети;
	КонецЕсли;

	Если Ответ.КодСостояния <> 200 Тогда
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
		Ответ.Закрыть();
		ВызватьИсключение СтрШаблон("%1 ответил кодом %2 на запрос списка пакетов: %3",
			АдресДляСообщений(), Формат(Ответ.КодСостояния, "ЧГ=0"), СокрЛП(ТекстОтвета));
	КонецЕсли;
	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
	Ответ.Закрыть();

	Возврат ТекстОтвета;

КонецФункции

Функция ПолучитьПакеты() Экспорт

	ПакетыХаба = Новый Соответствие;

	ТекстОтвета = "";

	Попытка
		ТекстОтвета = ПолучитьСписокПакетов("list.txt");
	Исключение
		Лог.Предупреждение(
			СтрШаблон("Ошибка получения списка пакетов с хаба %1 по причине %2", 
			Имя, ОписаниеОшибки()
			)
		);
	КонецПопытки;

	ПрочитатьФайлСпискаПакетов(ТекстОтвета);
	
	Возврат ПакетыХаба;

КонецФункции

Процедура ДобавитьЗаголовки(Знач Запрос)
	
	Если ЗначениеЗаполнено(ДополнительныеЗаголовки) Тогда
		Для Каждого мЗаголовок Из ДополнительныеЗаголовки Цикл
			ДобавитьЗаголовокКЗапросу(Запрос, мЗаголовок.Ключ, мЗаголовок.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Авторизация) Тогда
		ДобавитьЗаголовокКЗапросу(Запрос, "Authorization", Авторизация);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьЗаголовокКЗапросу(Знач Запрос, Знач Заголовок, Знач Значение)
	Запрос.Заголовки.Вставить(Заголовок, ОбщегоНазначенияOpm.ПрименитьПеременныеСреды(Значение));
КонецПроцедуры

Функция НастройкаДляВыгрузки() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Сервер", Сервер);
	Результат.Вставить("ПутьНаСервере", ПутьНаСервере);
	Результат.Вставить("РесурсПубликацииПакетов", РесурсПубликацииПакетов);
	Если ЗначениеЗаполнено(Порт) Тогда
		Результат.Вставить("Порт", Порт);
	КонецЕсли;
	Результат.Вставить("Таймаут", Таймаут);
	Результат.Вставить("Авторизация", Авторизация);
	Результат.Вставить("Заголовки", ДополнительныеЗаголовки);
	Результат.Вставить("Приоритет", Приоритет);
	
	Возврат Результат;

КонецФункции //

Лог = Логирование.ПолучитьЛог("oscript.app.opm");
ДополнительныеЗаголовки = Новый Соответствие;
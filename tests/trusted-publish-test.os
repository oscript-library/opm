#Использовать asserts
#Использовать "../src/core"

Перем юТест;

Функция ПолучитьСписокТестов(Знач Тестирование) Экспорт

	юТест = Тестирование;

	СписокТестов = Новый Массив;

	СписокТестов.Добавить("ТестДолжен_ВзятьТокенИзПеременнойGitLab");
	СписокТестов.Добавить("ТестДолжен_НазватьПеременнуюGitLabВОтказе");
	СписокТестов.Добавить("ТестДолжен_ЗапроситьТокенУСервисаGitHub");
	СписокТестов.Добавить("ТестДолжен_ЗапроситьТокенСАдресомХабаВАудитории");
	СписокТестов.Добавить("ТестДолжен_ОтказатьБезПеременныхКонвейера");

	Возврат СписокТестов;

КонецФункции

Процедура ПослеЗапускаТеста() Экспорт
	УстановитьПеременнуюСреды("OPENHUB_TOKEN", "");
	УстановитьПеременнуюСреды("ACTIONS_ID_TOKEN_REQUEST_URL", "");
	УстановитьПеременнуюСреды("ACTIONS_ID_TOKEN_REQUEST_TOKEN", "");
КонецПроцедуры

Процедура ТестДолжен_ВзятьТокенИзПеременнойGitLab() Экспорт

	УстановитьПеременнуюСреды("OPENHUB_TOKEN", "id.token.gitlab");

	Ожидаем.Что(ТокенКонвейераCI.Получить(СерверХаба())).Равно("id.token.gitlab");

КонецПроцедуры

Процедура ТестДолжен_НазватьПеременнуюGitLabВОтказе() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(СерверХаба());

	Ожидаем.Что(ТокенКонвейераCI).Метод("Получить", Параметры).ВыбрасываетИсключение("OPENHUB_TOKEN в блоке id_tokens");

КонецПроцедуры

Процедура ТестДолжен_ЗапроситьТокенУСервисаGitHub() Экспорт

	Соединение = СоединениеGitHub();

	Ожидаем.Что(ТокенКонвейераCI.Получить(СерверХаба(), "https://aud.example", Соединение)).Равно("id.token.github");
	Ожидаем.Что(Соединение.Запрос.АдресРесурса).Равно("/idtoken?api-version=2.0&audience=https%3A%2F%2Faud.example");
	Ожидаем.Что(Соединение.Запрос.Заголовки["Authorization"]).Равно("bearer токен-запроса");

КонецПроцедуры

Процедура ТестДолжен_ЗапроситьТокенСАдресомХабаВАудитории() Экспорт

	Соединение = СоединениеGitHub();

	ТокенКонвейераCI.Получить(СерверХаба(), "", Соединение);

	Ожидаем.Что(Соединение.Запрос.АдресРесурса).Равно("/idtoken?api-version=2.0&audience=https%3A%2F%2Fhub.example");

КонецПроцедуры

Процедура ТестДолжен_ОтказатьБезПеременныхКонвейера() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(СерверХаба());

	Ожидаем.Что(ТокенКонвейераCI).Метод("Получить", Параметры).ВыбрасываетИсключение("permissions: id-token: write");

КонецПроцедуры

Функция СерверХаба()
	Возврат СерверыПакетов.ИзАдреса(АдресаХаба.Адрес("hub.example", "corp"));
КонецФункции

Функция СоединениеGitHub()

	УстановитьПеременнуюСреды("ACTIONS_ID_TOKEN_REQUEST_URL", "https://tokens.example/idtoken?api-version=2.0");
	УстановитьПеременнуюСреды("ACTIONS_ID_TOKEN_REQUEST_TOKEN", "токен-запроса");

	Ответ = ЗагрузитьЗаглушку("ЗаглушкаОтветаХаба.os");
	Ответ.Тело = "{""count"": 1, ""value"": ""id.token.github""}";

	Соединение = ЗагрузитьЗаглушку("ЗаглушкаКонвейера.os");
	Соединение.Ответ = Ответ;

	Возврат Соединение;

КонецФункции

Функция ЗагрузитьЗаглушку(Знач ИмяФайла)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", ИмяФайла));
КонецФункции

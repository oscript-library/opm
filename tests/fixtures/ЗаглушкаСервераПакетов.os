// Сервер пакетов без сети: отвечает заданным ответом.

Перем Имя Экспорт;

Перем Пакеты;
Перем Ответ;

Процедура ПриСозданииОбъекта(Знач ИмяСервера = "ЗаглушкаХаба")
	Имя = ИмяСервера;
	Пакеты = Новый Соответствие();
КонецПроцедуры

Процедура ОбъявитьПакет(Знач ИмяПакета) Экспорт
	Пакеты.Вставить(ИмяПакета, "");
КонецПроцедуры

Процедура Отвечать(Знач ОтветХаба) Экспорт
	Ответ = ОтветХаба;
КонецПроцедуры

Функция ПолучитьИмя() Экспорт
	Возврат Имя;
КонецФункции

Функция СерверДоступен() Экспорт
	Возврат Истина;
КонецФункции

Функция ПолучитьПакеты() Экспорт
	Возврат Пакеты;
КонецФункции

Функция ПолучитьРесурс(Знач ИмяРесурса) Экспорт
	Возврат Ответ;
КонецФункции

// Заглушка команды приложения cli: заранее заданные значения опций и аргументов.
// Нужна, чтобы проверять сам ВыполнитьКоманду, а не только его составные части.

Перем Опции;
Перем Аргументы;

// Задаёт значение опции.
//
// Параметры:
//  Имя - Строка - имя опции без дефисов.
//  Значение - Произвольный - значение, которое вернёт ЗначениеОпции.
//
Процедура ЗадатьОпцию(Знач Имя, Знач Значение) Экспорт

	Опции.Вставить(Имя, Значение);

КонецПроцедуры

// Задаёт значение аргумента.
//
// Параметры:
//  Имя - Строка - имя аргумента.
//  Значение - Произвольный - значение, которое вернёт ЗначениеАргумента.
//
Процедура ЗадатьАргумент(Знач Имя, Знач Значение) Экспорт

	Аргументы.Вставить(Имя, Значение);

КонецПроцедуры

Функция ЗначениеОпции(Знач Имя) Экспорт

	Значение = Опции.Получить(Имя);

	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

Функция ЗначениеАргумента(Знач Имя) Экспорт

	Возврат Аргументы.Получить(Имя);

КонецФункции

Опции = Новый Соответствие();
Аргументы = Новый Соответствие();

#Использовать asserts
#Использовать "../src/core"
#Использовать "../src/cmd"

Перем юТест;
Перем ДомашнийКаталог;
Перем ПрежниеПеременные;

Функция ПолучитьСписокТестов(Знач Тестирование) Экспорт

	юТест = Тестирование;

	СписокТестов = Новый Массив;

	СписокТестов.Добавить("ТестДолжен_СохранитьТокенХабаВФайлеПользователя");
	СписокТестов.Добавить("ТестДолжен_ВзятьТокенХабаДляАдреса");
	СписокТестов.Добавить("ТестДолжен_ПрочитатьТокенИзСтандартногоВвода");
	СписокТестов.Добавить("ТестДолжен_ОтказатьсяОткрыватьАдресНеПоHttp");

	Возврат СписокТестов;

КонецФункции

Процедура ПередЗапускомТеста() Экспорт

	ДомашнийКаталог = юТест.ИмяВременногоФайла();
	СоздатьКаталог(ДомашнийКаталог);
	ПрежниеПеременные = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("HOME,USERPROFILE", ",") Цикл
		ПрежниеПеременные.Вставить(Имя, ПолучитьПеременнуюСреды(Имя));
		УстановитьПеременнуюСреды(Имя, ДомашнийКаталог);
	КонецЦикла;
	НастройкиOpm.СброситьНастройки();

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт

	Для Каждого Переменная Из ПрежниеПеременные Цикл
		УстановитьПеременнуюСреды(Переменная.Ключ, ?(Переменная.Значение = Неопределено, "", Переменная.Значение));
	КонецЦикла;
	НастройкиOpm.СброситьНастройки();
	юТест.УдалитьВременныеФайлы();

КонецПроцедуры

Процедура ТестДолжен_СохранитьТокенХабаВФайлеПользователя() Экспорт

	ФайлНастроек = ФайлНастроекПользователя();
	ЗаписатьФайл(ФайлНастроек, "{""СоздаватьShСкриптЗапуска"": true}");

	Путь = ПараметрыПриложенияOpm.СохранитьТокенХаба("http://hub.example:3380", "токен");
	ПараметрыПриложенияOpm.СохранитьТокенХаба("https://other.example", "другой");

	Ожидаем.Что(Путь).Равно(ФайлНастроек);
	Настройки = ПрочитатьНастройки(ФайлНастроек);
	Ожидаем.Что(Настройки["СоздаватьShСкриптЗапуска"], "прежние настройки").ЭтоИстина();
	Ожидаем.Что(Настройки["ТокеныХабов"]["http://hub.example:3380"]).Равно("токен");
	Ожидаем.Что(Настройки["ТокеныХабов"]["https://other.example"]).Равно("другой");

	Если ЭтоWindows() Тогда
		Возврат;
	КонецЕсли;
	Процесс = СоздатьПроцесс(СтрШаблон("ls -l ""%1""", ФайлНастроек), , Истина);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();
	Ожидаем.Что(Лев(Процесс.ПотокВывода.Прочитать(), 10), "права файла").Равно("-rw-------");

КонецПроцедуры

Процедура ТестДолжен_ВзятьТокенХабаДляАдреса() Экспорт

	ПараметрыПриложенияOpm.СохранитьТокенХаба("http://hub.example:3380", "токен");
	ПараметрыПриложенияOpm.НастроитьOpm();

	Ожидаем.Что(СерверыПакетов.ИзАдреса(АдресаХаба.Адрес("hub.example:3380", "corp")).Авторизация)
		.Равно("Bearer токен");
	Ожидаем.Что(СерверыПакетов.ИзАдреса(АдресаХаба.АдресПакета("hub.example/corp/pkg")).Авторизация, "другой порт")
		.Равно("");

	НастройкиOpm.ДобавитьСерверПакетов(Новый СерверПакетов("свой", "http://hub.example", , , 3380, 0, "Bearer свой"));
	Ожидаем.Что(СерверыПакетов.ИзАдреса(АдресаХаба.Адрес("hub.example:3380")).Авторизация, "авторизация из opm.cfg")
		.Равно("Bearer свой");

КонецПроцедуры

Процедура ТестДолжен_ПрочитатьТокенИзСтандартногоВвода() Экспорт

	Процесс = СоздатьПроцесс(СтрШаблон("oscript ""%1"" login --token-stdin hub.example:3380",
		ОбъединитьПути(ТекущийСценарий().Каталог, "../src/cmd/opm.os")), , Истина, Истина);
	Процесс.Запустить();
	Процесс.ПотокВвода.ЗаписатьСтроку(" токен ");
	Процесс.ПотокВвода.Закрыть();
	Процесс.ОжидатьЗавершения();

	Ожидаем.Что(Процесс.КодВозврата, Процесс.ПотокВывода.Прочитать()).Равно(0);
	Настройки = ПрочитатьНастройки(ФайлНастроекПользователя());
	Ожидаем.Что(Настройки["ТокеныХабов"]["http://hub.example:3380"]).Равно("токен");

КонецПроцедуры

Процедура ТестДолжен_ОтказатьсяОткрыватьАдресНеПоHttp() Экспорт

	Вход = Новый КомандаOpm_Login();

	Для Каждого Адрес Из СтрРазделить("file:///etc/passwd|javascript:alert(1)|https://hub/""x", "|") Цикл
		Попытка
			Вход.ОткрытьВБраузере(Адрес);
		Исключение
			Ожидаем.Что(ИнформацияОбОшибке().Описание, Адрес).Содержит("негодный адрес входа");
			Продолжить;
		КонецПопытки;
		юТест.ПрерватьТест("Открыт адрес " + Адрес);
	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьНастройки(Знач Путь)

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(Путь);
	Настройки = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Настройки;

КонецФункции

Процедура ЗаписатьФайл(Знач Путь, Знач Текст)

	Запись = Новый ЗаписьТекста(Путь);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

Функция ФайлНастроекПользователя()
	Возврат ОбъединитьПути(ДомашнийКаталог, ?(ЭтоWindows(), "opm.cfg", ".opm.cfg"));
КонецФункции

Функция ЭтоWindows()
	Возврат Найти(НРег(Новый СистемнаяИнформация().ВерсияОС), "windows") > 0;
КонецФункции

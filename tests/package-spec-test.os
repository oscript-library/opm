#Использовать asserts
#Использовать "../src/core"

Перем юТест;
Перем Хаб;

Функция ПолучитьСписокТестов(Знач Тестирование) Экспорт

	юТест = Тестирование;

	СписокТестов = Новый Массив;

	СписокТестов.Добавить("ТестДолжен_ЗапроситьФайлВерсииИСпецификациюОтдельно");
	СписокТестов.Добавить("ТестДолжен_ЗапроситьФайлБезСпецификацииКогдаЕёНеНазвали");
	СписокТестов.Добавить("ТестДолжен_СобратьАдресЗапросаСоСпецификацией");
	СписокТестов.Добавить("ТестДолжен_СобратьАдресЗапросаБезСпецификации");
	СписокТестов.Добавить("ТестДолжен_ЗакодироватьСпецификациюВАдресе");
	СписокТестов.Добавить("ТестДолжен_СохранитьПрежнийОтказНаТочнуюВерсию");
	СписокТестов.Добавить("ТестДолжен_ЗапретитьФайловомуСерверуПодборПодСпецификацию");
	СписокТестов.Добавить("ТестДолжен_ОставитьФайловомуСерверуПодборБезСпецификации");

	Возврат СписокТестов;

КонецФункции

Процедура ПередЗапускомТеста() Экспорт

	Хаб = ЗагрузитьЗаглушку("ЗаглушкаСервераПакетов.os");
	Хаб.ОбъявитьПакет("vrunner");
	Хаб.Отвечать(ОтветХаба(200));

	НастройкиOpm.СброситьНастройки();
	НастройкиOpm.ДобавитьСерверПакетов(Хаб);

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт

	НастройкиOpm.СброситьНастройки();
	ВременныеФайлы.Удалить();

КонецПроцедуры

Процедура ТестДолжен_ЗапроситьФайлВерсииИСпецификациюОтдельно() Экспорт

	Для Каждого Спецификация Из СтрРазделить("stable,^1.4,~1.4,1.4", ",") Цикл

		Скачать("vrunner", Спецификация);

		Ожидаем.Что(Хаб.ПоследнийЗапрос().ИмяРесурса, "имя ресурса для " + Спецификация)
			.Равно(СтрШаблон("vrunner/vrunner-%1.ospx", Спецификация));
		Ожидаем.Что(Хаб.ПоследнийЗапрос().Спецификация, "спецификация").Равно(Спецификация);

	КонецЦикла;

КонецПроцедуры

Процедура ТестДолжен_ЗапроситьФайлБезСпецификацииКогдаЕёНеНазвали() Экспорт

	Скачать("vrunner", Неопределено);

	Ожидаем.Что(Хаб.ПоследнийЗапрос().ИмяРесурса, "имя ресурса").Равно("vrunner/vrunner.ospx");
	Ожидаем.Что(Хаб.ПоследнийЗапрос().Спецификация, "спецификация").Равно(Неопределено);

КонецПроцедуры

Процедура ТестДолжен_СобратьАдресЗапросаСоСпецификацией() Экспорт

	Сервер = СерверПробы();

	Ожидаем.Что(Сервер.АдресРесурса("vrunner/vrunner-stable.ospx", "stable"), "тег")
		.Равно("/download/vrunner/vrunner-stable.ospx?spec=stable");
	Ожидаем.Что(Сервер.АдресРесурса("vrunner/vrunner-1.0.0.ospx", "1.0.0"), "точная версия")
		.Равно("/download/vrunner/vrunner-1.0.0.ospx?spec=1.0.0");

КонецПроцедуры

Процедура ТестДолжен_СобратьАдресЗапросаБезСпецификации() Экспорт

	Сервер = СерверПробы();

	Ожидаем.Что(Сервер.АдресРесурса("vrunner/vrunner.ospx"), "файл пакета").Равно("/download/vrunner/vrunner.ospx");
	Ожидаем.Что(Сервер.АдресРесурса("vrunner/vrunner-.ospx", ""), "пустая спецификация")
		.Равно("/download/vrunner/vrunner-.ospx");
	Ожидаем.Что(Сервер.АдресРесурса("list.txt"), "список пакетов").Равно("/download/list.txt");

КонецПроцедуры

Процедура ТестДолжен_ЗакодироватьСпецификациюВАдресе() Экспорт

	Сервер = СерверПробы();

	Для Каждого Образец Из СтрРазделить("^1.4|~1.4|1.0.0-rc.1+build|>=1.0 <2.0|feature/foo", "|") Цикл

		Адрес = Сервер.АдресРесурса("vrunner/vrunner.ospx", Образец);
		Параметр = Сред(Адрес, СтрНайти(Адрес, "?spec=") + СтрДлина("?spec="));

		Ожидаем.Что(СтрНайти(Параметр, "+") + СтрНайти(Параметр, " ") + СтрНайти(Параметр, "/"),
			"служебные символы закодированы в " + Адрес).Равно(0);
		Ожидаем.Что(РаскодироватьСтроку(Параметр, СпособКодированияСтроки.КодировкаURL), "значение в " + Адрес)
			.Равно(Образец);

	КонецЦикла;

	Ожидаем.Что(Сервер.АдресРесурса("vrunner/vrunner-^1.4.ospx", "^1.4"), "имя файла")
		.Равно("/download/vrunner/vrunner-%5E1.4.ospx?spec=%5E1.4");

КонецПроцедуры

Процедура ТестДолжен_СохранитьПрежнийОтказНаТочнуюВерсию() Экспорт

	Хаб.Отвечать(ОтветХаба(404));

	Ожидаем.Что(ТекстОтказа("vrunner", "1.4"), "точная версия").Содержит("файл vrunner-1.4.ospx в хабе не найден");
	Ожидаем.Что(ТекстОтказа("vrunner", Неопределено), "без спецификации")
		.Содержит("файл vrunner.ospx в хабе не найден");
	Ожидаем.Что(ТекстОтказа("vrunner", ""), "пустая спецификация").Содержит("файл vrunner-.ospx в хабе не найден");

КонецПроцедуры

Процедура ТестДолжен_ЗапретитьФайловомуСерверуПодборПодСпецификацию() Экспорт

	Сервер = Новый ФайловыйСерверПакетов("зеркалоПробы", "file://", КаталогФайловогоСервера());

	Ожидаем.Что(Сервер.ПолучитьРесурс("vrunner/vrunner-stable.ospx", "stable").КодСостояния, "тег").Равно(404);
	Ожидаем.Что(Сервер.ПолучитьРесурс("vrunner/vrunner-0.0.1.ospx", "0.0.1").КодСостояния, "версии нет")
		.Равно(404);
	Ожидаем.Что(Сервер.ПолучитьРесурс("vrunner/vrunner-9.9.9.ospx", "9.9.9").КодСостояния, "версия есть")
		.Равно(200);

КонецПроцедуры

Процедура ТестДолжен_ОставитьФайловомуСерверуПодборБезСпецификации() Экспорт

	Сервер = Новый ФайловыйСерверПакетов("зеркалоПробы", "file://", КаталогФайловогоСервера());

	Ожидаем.Что(Сервер.ПолучитьРесурс("vrunner/vrunner.ospx").КодСостояния, "подбор старшей версии").Равно(200);

КонецПроцедуры

Функция ЗагрузитьЗаглушку(Знач ИмяФайла)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", ИмяФайла));
КонецФункции

Функция ОтветХаба(Знач Код)
	Ответ = ЗагрузитьЗаглушку("ЗаглушкаОтветаХаба.os");
	Ответ.КодСостояния = Код;
	Возврат Ответ;
КонецФункции

Функция СерверПробы()
	Возврат Новый СерверПакетов("ХабПробы", "http://hub.example.com", "/download/", "/push", 80);
КонецФункции

Функция Скачать(Знач ИмяПакета, Знач Спецификация)
	Возврат Новый МенеджерПолученияПакетов().ПолучитьПакет(ИмяПакета, Спецификация);
КонецФункции

Функция ТекстОтказа(Знач ИмяПакета, Знач Спецификация)

	Попытка
		Скачать(ИмяПакета, Спецификация);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;

	ВызватьИсключение СтрШаблон("Скачивание <%1@%2> должно было провалиться", ИмяПакета, Спецификация);

КонецФункции

// В каталоге одна версия 9.9.9: подбор выдал бы её за любую запрошенную.
Функция КаталогФайловогоСервера()

	Каталог = юТест.ИмяВременногоФайла();
	СоздатьКаталог(ОбъединитьПути(Каталог, "vrunner"));

	Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, "vrunner", "vrunner-9.9.9.ospx"));
	Запись.Записать("файл пакета");
	Запись.Закрыть();

	Возврат Каталог;

КонецФункции

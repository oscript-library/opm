#Использовать asserts
#Использовать "../src/core"
#Использовать "../src/cmd"

Перем юТест;

Функция ПолучитьСписокТестов(Знач Тестирование) Экспорт

	юТест = Тестирование;

	ИменаТестов = Новый Массив;
	ИменаТестов.Добавить("ТестДолжен_ИспользоватьЯвныйПортСервераПакетовПриПубликации");
	ИменаТестов.Добавить("ТестДолжен_ИспользоватьПорт80ДляHttpПубликацииБезЯвногоПорта");
	ИменаТестов.Добавить("ТестДолжен_ИспользоватьПорт443ДляHttpsПубликацииБезЯвногоПорта");
	ИменаТестов.Добавить("ТестДолжен_ПрименитьПроксиПриПубликации");

	Возврат ИменаТестов;

КонецФункции

Процедура ПередЗапускомТеста() Экспорт

	НастройкиOpm.СброситьНастройки();

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт

	НастройкиOpm.СброситьНастройки();
	ПараметрыПриложенияOpm.НастроитьOpm();

КонецПроцедуры

Функция ПараметрыСоединенияПубликации(Знач ИмяСервераПакетов)

	КомандаPush = Новый КомандаOpm_Push;
	Возврат КомандаPush.ПолучитьПараметрыСоединенияПубликации(ИмяСервераПакетов);

КонецФункции

Процедура ТестДолжен_ИспользоватьЯвныйПортСервераПакетовПриПубликации() Экспорт

	НастройкиOpm.ДобавитьСерверПакетов("ТестовыйСервер", "http://packages.example.com", "/download/", "/push", 8080);

	ПараметрыСоединения = ПараметрыСоединенияПубликации("ТестовыйСервер");

	Ожидаем.Что(ПараметрыСоединения.Порт, "Публикация должна использовать явный порт из настроек сервера")
		.Равно(8080);

КонецПроцедуры

Процедура ТестДолжен_ИспользоватьПорт80ДляHttpПубликацииБезЯвногоПорта() Экспорт

	НастройкиOpm.ДобавитьСерверПакетов("HttpСервер", "http://packages.example.com", "/download/", "/push");

	ПараметрыСоединения = ПараметрыСоединенияПубликации("HttpСервер");

	Ожидаем.Что(ПараметрыСоединения.Порт, "HTTP-публикация без явного порта должна использовать 80")
		.Равно(80);

КонецПроцедуры

Процедура ТестДолжен_ИспользоватьПорт443ДляHttpsПубликацииБезЯвногоПорта() Экспорт

	НастройкиOpm.ДобавитьСерверПакетов("HttpsСервер", "https://packages.example.com", "/download/", "/push");

	ПараметрыСоединения = ПараметрыСоединенияПубликации("HttpsСервер");

	Ожидаем.Что(ПараметрыСоединения.Порт, "HTTPS-публикация без явного порта должна использовать 443")
		.Равно(443);

КонецПроцедуры

Процедура ТестДолжен_ПрименитьПроксиПриПубликации() Экспорт

	НастройкиOpm.ДобавитьСерверПакетов("ТестовыйСервер", "http://packages.example.com", "/download/", "/push");
	НастройкиOpm.УстановитьНастройкиПроксиСервера("proxy.example.com", 3128);

	ПараметрыСоединения = ПараметрыСоединенияПубликации("ТестовыйСервер");

	Ожидаем.Что(ПараметрыСоединения.ИспользоватьПрокси, "Публикация должна учитывать включенный прокси")
		.Равно(Истина);
	Ожидаем.Что(ПараметрыСоединения.НастройкиПрокси = Неопределено, "Для публикации должны быть подготовлены настройки прокси")
		.Равно(Ложь);

КонецПроцедуры

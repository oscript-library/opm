#Использовать asserts
#Использовать "../src/core"

Функция ПолучитьСписокТестов(Знач Тестирование) Экспорт

	СписокТестов = Новый Массив;

	СписокТестов.Добавить("ТестДолжен_ПубликоватьВПулИзОпцииХаба");
	СписокТестов.Добавить("ТестДолжен_ОтказатьНаПутиВОпцииХаба");
	СписокТестов.Добавить("ТестДолжен_ПубликоватьВПулХабаПоУмолчанию");
	СписокТестов.Добавить("ТестДолжен_ПубликоватьНаСерверИзНастроекПоИмени");
	СписокТестов.Добавить("ТестДолжен_ПубликоватьВХабПоУмолчанию");
	СписокТестов.Добавить("ТестДолжен_ДобавитьForceКРесурсуПубликации");
	СписокТестов.Добавить("ТестДолжен_НеДобавлятьForceБезОпции");

	Возврат СписокТестов;

КонецФункции

Процедура ПередЗапускомТеста() Экспорт
	НастройкиOpm.СброситьНастройки();
КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	НастройкиOpm.СброситьНастройки();
КонецПроцедуры

Процедура ТестДолжен_ПубликоватьВПулИзОпцииХаба() Экспорт

	Сервер = СерверыПакетов.ДляПубликации("127.0.0.1:3380", "", "corp");

	Ожидаем.Что(Сервер.Сервер).Равно("http://127.0.0.1");
	Ожидаем.Что(Сервер.Порт).Равно(3380);
	Ожидаем.Что(Сервер.РесурсПубликацииПакетов).Равно("/api/v1/pools/corp/push");

КонецПроцедуры

Процедура ТестДолжен_ОтказатьНаПутиВОпцииХаба() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить("hub.example/corp");
	Параметры.Добавить("");

	Ожидаем.Что(СерверыПакетов).Метод("ДляПубликации", Параметры).ВыбрасываетИсключение("без пути, пул задаётся опцией --pool");

КонецПроцедуры

Процедура ТестДолжен_ПубликоватьВПулХабаПоУмолчанию() Экспорт

	Сервер = СерверыПакетов.ДляПубликации("", "", "corp");

	Ожидаем.Что(Сервер.Сервер).Равно("http://hub.oscript.io");
	Ожидаем.Что(Сервер.РесурсПубликацииПакетов).Равно("/api/v1/pools/corp/push");

КонецПроцедуры

Процедура ТестДолжен_ПубликоватьНаСерверИзНастроекПоИмени() Экспорт

	НастройкиOpm.ДобавитьСерверПакетов(Новый СерверПакетов("corp", "https://hub.example", , "/api/v1/pools/corp/push"));

	Ожидаем.Что(СерверыПакетов.ДляПубликации("", "corp").РесурсПубликацииПакетов).Равно("/api/v1/pools/corp/push");

КонецПроцедуры

Процедура ТестДолжен_ПубликоватьВХабПоУмолчанию() Экспорт

	Сервер = СерверыПакетов.ДляПубликации("", "");

	Ожидаем.Что(Сервер.Сервер).Равно(КонстантыOpm.СерверУдаленногоХранилища);
	Ожидаем.Что(Сервер.РесурсПубликацииПакетов).Равно(КонстантыOpm.РесурсПубликацииПакетов);

КонецПроцедуры

Процедура ТестДолжен_ДобавитьForceКРесурсуПубликации() Экспорт

	Сервер = СерверыПакетов.ДляПубликации("127.0.0.1:3380", "", "corp", Истина);
	Ожидаем.Что(Сервер.РесурсПубликацииПакетов, "пул хаба").Равно("/api/v1/pools/corp/push?force=1");

	НастройкиOpm.ДобавитьСерверПакетов(Новый СерверПакетов("corp", "https://hub.example", , "/push?owner=corp"));
	Сервер = СерверыПакетов.ДляПубликации("", "corp", , Истина);
	Ожидаем.Что(Сервер.РесурсПубликацииПакетов, "ресурс с параметрами").Равно("/push?owner=corp&force=1");

КонецПроцедуры

Процедура ТестДолжен_НеДобавлятьForceБезОпции() Экспорт

	Ожидаем.Что(СерверыПакетов.ДляПубликации("127.0.0.1:3380", "", "corp").РесурсПубликацииПакетов)
		.Равно("/api/v1/pools/corp/push");
	Ожидаем.Что(СерверыПакетов.ДляПубликации("127.0.0.1:3380", "", "corp", Ложь).РесурсПубликацииПакетов)
		.Равно("/api/v1/pools/corp/push");

КонецПроцедуры

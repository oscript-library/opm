#Использовать asserts
#Использовать tempfiles
#Использовать "../src/core"
#Использовать "../src/cmd"

Перем юТест;
Перем мВременныеФайлы;
Перем мИсходныйКаталог;

Функция ПолучитьСписокТестов(Знач Тестирование) Экспорт

	юТест = Тестирование;

	ИменаТестов = Новый Массив;
	ИменаТестов.Добавить("ТестДолжен_ЗагрузитьПоляПроксиПриВыключенномИспользовании");

	Возврат ИменаТестов;

КонецФункции

Процедура ПередЗапускомТеста() Экспорт
	мИсходныйКаталог = ТекущийКаталог();
КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт

	УстановитьТекущийКаталог(мИсходныйКаталог);

	Если мВременныеФайлы <> Неопределено Тогда
		мВременныеФайлы.Удалить();
		мВременныеФайлы = Неопределено;
	КонецЕсли;

	НастройкиOpm.СброситьНастройки();
	ПараметрыПриложенияOpm.НастроитьOpm();

КонецПроцедуры

Процедура ТестДолжен_ЗагрузитьПоляПроксиПриВыключенномИспользовании() Экспорт

	мВременныеФайлы = Новый МенеджерВременныхФайлов;
	КаталогНастроек = мВременныеФайлы.СоздатьКаталог();

	НастройкиДокумента = Новый Структура;
	НастройкиПрокси = Новый Структура;
	НастройкиПрокси.Вставить("ИспользоватьПрокси", Ложь);
	НастройкиПрокси.Вставить("Сервер", "proxy.example.com");
	НастройкиПрокси.Вставить("Порт", 3128);
	НастройкиПрокси.Вставить("Пользователь", "proxyuser");
	НастройкиПрокси.Вставить("Пароль", "proxypass");
	НастройкиДокумента.Вставить("Прокси", НастройкиПрокси);

	ПутьФайла = ОбъединитьПути(КаталогНастроек, КонстантыOpm.ИмяФайлаНастроек);
	ПараметрыПриложенияOpm.СохранитьНастройки(НастройкиДокумента, ПутьФайла);

	УстановитьТекущийКаталог(КаталогНастроек);
	НастройкиOpm.СброситьНастройки();
	ПараметрыПриложенияOpm.НастроитьOpm();

	ТекущиеНастройки = НастройкиOpm.ПолучитьНастройки();
	НастройкиПроксиМодели = ТекущиеНастройки.НастройкиПрокси;

	Ожидаем.Что(НастройкиПроксиМодели.Сервер, "Сервер прокси должен загрузиться из файла")
		.Равно("proxy.example.com");
	Ожидаем.Что(НастройкиПроксиМодели.Порт, "Порт прокси должен загрузиться из файла")
		.Равно(3128);
	Ожидаем.Что(НастройкиПроксиМодели.Пользователь, "Пользователь прокси должен загрузиться из файла")
		.Равно("proxyuser");
	Ожидаем.Что(НастройкиПроксиМодели.Пароль, "Пароль прокси должен загрузиться из файла")
		.Равно("proxypass");
	Ожидаем.Что(ТекущиеНастройки.ИспользоватьПрокси, "ИспользоватьПрокси должен остаться Ложь")
		.Равно(Ложь);
	Ожидаем.Что(ТекущиеНастройки.ИспользоватьСистемныйПрокси, "ИспользоватьСистемныйПрокси должен быть Ложь")
		.Равно(Ложь);

КонецПроцедуры

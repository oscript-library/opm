#Использовать asserts
#Использовать "../src/core"

Перем юТест;
Перем Хаб;

Функция ПолучитьСписокТестов(Знач Тестирование) Экспорт

	юТест = Тестирование;

	СписокТестов = Новый Массив;

	СписокТестов.Добавить("ТестДолжен_СообщитьОтсутствиеФайлаПоКоду404");
	СписокТестов.Добавить("ТестДолжен_СообщитьОтказВДоступеПоКодам401И403");
	СписокТестов.Добавить("ТестДолжен_НазватьИнойКодОтвета");
	СписокТестов.Добавить("ТестДолжен_НазватьАдресСервераБезОтвета");

	Возврат СписокТестов;

КонецФункции

Процедура ПередЗапускомТеста() Экспорт

	Хаб = ЗагрузитьЗаглушку("ЗаглушкаСервераПакетов.os");
	Хаб.ОбъявитьПакет("vrunner");

	НастройкиOpm.СброситьНастройки();
	НастройкиOpm.ДобавитьСерверПакетов(Хаб);

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт

	НастройкиOpm.СброситьНастройки();
	ВременныеФайлы.Удалить();

КонецПроцедуры

Процедура ТестДолжен_СообщитьОтсутствиеФайлаПоКоду404() Экспорт

	Ожидаем.Что(ТекстОтказа(404), "404")
		.Равно("Ошибка установки пакета vrunner: файл vrunner.ospx в хабе не найден");

КонецПроцедуры

Процедура ТестДолжен_СообщитьОтказВДоступеПоКодам401И403() Экспорт

	Ожидаем.Что(ТекстОтказа(401), "401")
		.Равно("Ошибка установки пакета vrunner: хаб отказал в доступе к vrunner.ospx (код 401)");
	Ожидаем.Что(ТекстОтказа(403), "403")
		.Равно("Ошибка установки пакета vrunner: хаб отказал в доступе к vrunner.ospx (код 403)");

КонецПроцедуры

Процедура ТестДолжен_НазватьИнойКодОтвета() Экспорт

	Ожидаем.Что(ТекстОтказа(500), "500")
		.Равно("Ошибка установки пакета vrunner: хаб ответил кодом 500 на запрос vrunner.ospx");

КонецПроцедуры

Процедура ТестДолжен_НазватьАдресСервераБезОтвета() Экспорт

	// на порту 9 (discard) в тестовом окружении никто не слушает
	Сервер = Новый СерверПакетов("закрытый", "http://127.0.0.1", "/", "/", 9);

	Ожидаем.Что(Сервер.ПолучитьРесурс("list.txt"), "ответа нет").Равно(Неопределено);
	Ожидаем.Что(Сервер.ПоследняяОшибкаСети, "сообщение с адресом")
		.Равно("Не удалось подключиться к http://127.0.0.1:9");

	// недоступный сервер при получении списка пакетов только предупреждает
	Сервер.ПолучитьПакеты();

КонецПроцедуры

Функция ТекстОтказа(Знач Код)

	Ответ = ЗагрузитьЗаглушку("ЗаглушкаОтветаХаба.os");
	Ответ.КодСостояния = Код;
	Хаб.Отвечать(Ответ);

	Попытка
		Менеджер = Новый МенеджерПолученияПакетов();
		Менеджер.ПолучитьПакет("vrunner", Неопределено);
	Исключение
		Возврат ИнформацияОбОшибке().Описание;
	КонецПопытки;

	ВызватьИсключение СтрШаблон("Скачивание с кодом %1 должно было провалиться", Код);

КонецФункции

Функция ЗагрузитьЗаглушку(Знач ИмяФайла)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", ИмяФайла));
КонецФункции

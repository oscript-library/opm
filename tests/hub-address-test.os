#Использовать asserts
#Использовать "../src/core"

Перем юТест;

Функция ПолучитьСписокТестов(Знач Тестирование) Экспорт

	юТест = Тестирование;

	СписокТестов = Новый Массив;

	СписокТестов.Добавить("ТестДолжен_ОтличитьАдресОтИмениПакета");
	СписокТестов.Добавить("ТестДолжен_РазобратьАдресПакетаСПуломИСпецификацией");
	СписокТестов.Добавить("ТестДолжен_РазобратьАдресПакетаВПулеПоУмолчанию");
	СписокТестов.Добавить("ТестДолжен_ВыбратьСхемуПоУмолчанию");
	СписокТестов.Добавить("ТестДолжен_ОтказатьНаНеразобранномАдресе");
	СписокТестов.Добавить("ТестДолжен_СобратьСерверПулаПоАдресу");
	СписокТестов.Добавить("ТестДолжен_ВзятьАвторизациюАдресаИзНастроек");
	СписокТестов.Добавить("ТестДолжен_УстанавливатьПакетССервераИзАдреса");
	СписокТестов.Добавить("ТестДолжен_УстанавливатьПакетСХабаИзОпций");

	Возврат СписокТестов;

КонецФункции

Процедура ПередЗапускомТеста() Экспорт
	НастройкиOpm.СброситьНастройки();
КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	НастройкиOpm.СброситьНастройки();
КонецПроцедуры

Процедура ТестДолжен_ОтличитьАдресОтИмениПакета() Экспорт

	Для Каждого Адрес Из СтрРазделить("hub.example/pkg|https://hub|http://hub/corp/pkg|localhost/pkg|hub:3380/pkg", "|") Цикл
		Ожидаем.Что(АдресаХаба.ЭтоАдресХаба(Адрес), Адрес).ЭтоИстина();
	КонецЦикла;

	Для Каждого Имя Из СтрРазделить("pkg|pkg@1.0.0|pkg@^1.4|hub.example|dir/pkg|./pkg|../dir/pkg|C:\dir\pkg", "|") Цикл
		Ожидаем.Что(АдресаХаба.ЭтоАдресХаба(Имя), Имя).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

Процедура ТестДолжен_РазобратьАдресПакетаСПуломИСпецификацией() Экспорт

	Адрес = АдресаХаба.АдресПакета("https://Hub.Example:8443/corp/pkg@stable");

	Ожидаем.Что(Адрес.Сервер).Равно("https://hub.example");
	Ожидаем.Что(Адрес.Порт).Равно(8443);
	Ожидаем.Что(Адрес.Пул).Равно("corp");
	Ожидаем.Что(Адрес.Пакет).Равно("pkg@stable");

КонецПроцедуры

Процедура ТестДолжен_РазобратьАдресПакетаВПулеПоУмолчанию() Экспорт

	Адрес = АдресаХаба.АдресПакета("hub.example/pkg/");

	Ожидаем.Что(Адрес.Пул).Равно("");
	Ожидаем.Что(Адрес.Пакет).Равно("pkg");
	Ожидаем.Что(Адрес.Порт).Равно(0);

КонецПроцедуры

Процедура ТестДолжен_ВыбратьСхемуПоУмолчанию() Экспорт

	Ожидаем.Что(АдресаХаба.АдресПакета("hub.example/pkg").Сервер, "публичное имя").Равно("https://hub.example");
	Ожидаем.Что(АдресаХаба.АдресПакета("localhost/pkg").Сервер, "localhost").Равно("http://localhost");
	Ожидаем.Что(АдресаХаба.АдресПакета("127.0.0.1/pkg").Сервер, "127.0.0.1").Равно("http://127.0.0.1");
	Ожидаем.Что(АдресаХаба.АдресПакета("hub.example:3380/pkg").Сервер, "явный порт").Равно("http://hub.example");
	Ожидаем.Что(АдресаХаба.Адрес("http://hub.example").Сервер, "явная схема").Равно("http://hub.example");

КонецПроцедуры

Процедура ТестДолжен_ОтказатьНаНеразобранномАдресе() Экспорт

	Для Каждого Адрес Из СтрРазделить("hub.example|hub.example/a/b/c|hub.example:порт/pkg|ftp://hub/pkg", "|") Цикл
		Ожидаем.Что(АдресаХаба).Метод("АдресПакета", ЗначенияПараметров(Адрес))
			.ВыбрасываетИсключение("ожидалось [схема://]хост[:порт]/[пул/]пакет[@спецификация]");
	КонецЦикла;

	Ожидаем.Что(АдресаХаба).Метод("Адрес", ЗначенияПараметров("hub.example/corp"))
		.ВыбрасываетИсключение("ожидалось [схема://]хост[:порт] без пути, пул задаётся опцией --pool");

	Адрес = АдресаХаба.Адрес("", "corp");
	Ожидаем.Что(Адрес.Сервер, "хаб по умолчанию").Равно("http://hub.oscript.io");
	Ожидаем.Что(Адрес.Пул).Равно("corp");

КонецПроцедуры

Процедура ТестДолжен_СобратьСерверПулаПоАдресу() Экспорт

	Сервер = СерверыПакетов.ИзАдреса(АдресаХаба.Адрес("hub.example:3380", "corp"));

	Ожидаем.Что(Сервер.ПолучитьИмя()).Равно("http://hub.example:3380/corp");
	Ожидаем.Что(Сервер.Сервер).Равно("http://hub.example");
	Ожидаем.Что(Сервер.Порт).Равно(3380);
	Ожидаем.Что(Сервер.ПутьНаСервере).Равно("/api/v1/pools/corp/download/");
	Ожидаем.Что(Сервер.РесурсПубликацииПакетов).Равно("/api/v1/pools/corp/push");

	Сервер = СерверыПакетов.ИзАдреса(АдресаХаба.Адрес("hub.example"));

	Ожидаем.Что(Сервер.ПолучитьИмя()).Равно("https://hub.example");
	Ожидаем.Что(Сервер.ПутьНаСервере, "пул по умолчанию").Равно("/download/");
	Ожидаем.Что(Сервер.РесурсПубликацииПакетов, "пул по умолчанию").Равно("/push");

КонецПроцедуры

Процедура ТестДолжен_ВзятьАвторизациюАдресаИзНастроек() Экспорт

	НастройкиOpm.ДобавитьСерверПакетов(Новый СерверПакетов("чужой", "https://other.example", , , 0, 0, "Bearer чужой"));
	НастройкиOpm.ДобавитьСерверПакетов(Новый СерверПакетов("свой", "https://HUB.example", , , 0, 0, "Bearer свой"));

	Ожидаем.Что(СерверыПакетов.ИзАдреса(АдресаХаба.АдресПакета("hub.example/corp/pkg")).Авторизация)
		.Равно("Bearer свой");
	Ожидаем.Что(СерверыПакетов.ИзАдреса(АдресаХаба.АдресПакета("hub.example:8443/corp/pkg")).Авторизация, "другой порт")
		.Равно("");

КонецПроцедуры

// Порт 1 на своей машине не слушают, а заглушка не даёт подставить серверы по умолчанию: сеть не нужна.
Процедура ТестДолжен_УстанавливатьПакетССервераИзАдреса() Экспорт

	НастройкиOpm.ДобавитьСерверПакетов(ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог,
		"fixtures", "ЗаглушкаСервераПакетов.os")));

	Попытка
		РаботаСПакетами.УстановитьПакетИзОблака("127.0.0.1:1/corp/pkg@1.0.0", РежимУстановкиПакетов.Локально,
			ОбъединитьПути(юТест.ИмяВременногоФайла(), "oscript_modules"));
		ВызватьИсключение "установка без хаба должна отказать";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Ошибка установки пакета pkg");
	КонецПопытки;

	Сервер = НастройкиOpm.ПолучитьНастройки().СервераПакетов[1];
	Ожидаем.Что(Сервер.ПолучитьИмя()).Равно("http://127.0.0.1:1/corp");
	Ожидаем.Что(Сервер.ПутьНаСервере).Равно("/api/v1/pools/corp/download/");

КонецПроцедуры

Процедура ТестДолжен_УстанавливатьПакетСХабаИзОпций() Экспорт

	НастройкиOpm.ДобавитьСерверПакетов(ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог,
		"fixtures", "ЗаглушкаСервераПакетов.os")));

	НастройкаУстановки = РаботаСПакетами.ПолучитьНастройкуУстановки();
	НастройкаУстановки.ИмяСервера = РаботаСПакетами.ПодключитьСерверХаба(АдресаХаба.Адрес("127.0.0.1:1", "corp"));

	Ожидаем.Что(НастройкаУстановки.ИмяСервера).Равно("http://127.0.0.1:1/corp");
	Ожидаем.Что(НастройкиOpm.ПолучитьНастройки().СервераПакетов[1].ПутьНаСервере).Равно("/api/v1/pools/corp/download/");

	Попытка
		РаботаСПакетами.УстановитьПакетИзОблака("pkg@1.0.0", РежимУстановкиПакетов.Локально,
			ОбъединитьПути(юТест.ИмяВременногоФайла(), "oscript_modules"), НастройкаУстановки);
		ВызватьИсключение "установка без хаба должна отказать";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Ошибка установки пакета pkg");
	КонецПопытки;

КонецПроцедуры

Функция ЗначенияПараметров(Знач Значение)
	Параметры = Новый Массив;
	Параметры.Добавить(Значение);
	Возврат Параметры;
КонецФункции

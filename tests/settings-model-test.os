#Использовать asserts
#Использовать tempfiles
#Использовать "../src/core"
#Использовать "../src/cmd"

Перем юТест;
Перем мВременныеФайлы;
Перем мИсходныйКаталог;

Функция ПолучитьСписокТестов(Знач Тестирование) Экспорт

	юТест = Тестирование;

	ИменаТестов = Новый Массив;
	ИменаТестов.Добавить("ТестДолжен_ЗагрузитьТокенПубликацииВМодель");
	ИменаТестов.Добавить("ТестДолжен_ИгнорироватьНеизвестныйКорневойКлюч");
	ИменаТестов.Добавить("ТестДолжен_ЗагрузитьИспользоватьАутентификациюОС");
	ИменаТестов.Добавить("ТестДолжен_ЗагрузитьПортПроксиПоУмолчанию");
	ИменаТестов.Добавить("ТестДолжен_ОставитьПортСервераПакетовНеопределеннымЕслиПолеОтсутствует");
	ИменаТестов.Добавить("ТестДолжен_СоздатьВстроенныеСервераПакетовБезЯвногоПорта");

	Возврат ИменаТестов;

КонецФункции

Процедура ПередЗапускомТеста() Экспорт
	мИсходныйКаталог = ТекущийКаталог();
КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт

	УстановитьТекущийКаталог(мИсходныйКаталог);

	Если мВременныеФайлы <> Неопределено Тогда
		мВременныеФайлы.Удалить();
		мВременныеФайлы = Неопределено;
	КонецЕсли;

	НастройкиOpm.СброситьНастройки();
	ПараметрыПриложенияOpm.НастроитьOpm();

КонецПроцедуры

Процедура ЗагрузитьНастройкиИзВременногоФайла(Знач НастройкиДокумента)

	мВременныеФайлы = Новый МенеджерВременныхФайлов;
	КаталогНастроек = мВременныеФайлы.СоздатьКаталог();

	ПутьФайла = ОбъединитьПути(КаталогНастроек, КонстантыOpm.ИмяФайлаНастроек);
	ПараметрыПриложенияOpm.СохранитьНастройки(НастройкиДокумента, ПутьФайла);

	УстановитьТекущийКаталог(КаталогНастроек);
	НастройкиOpm.СброситьНастройки();
	ПараметрыПриложенияOpm.НастроитьOpm();

КонецПроцедуры

Процедура ТестДолжен_ЗагрузитьТокенПубликацииВМодель() Экспорт

	НастройкиДокумента = Новый Структура;
	НастройкиДокумента.Вставить("ТокенПубликацииПакетов", "ghp_test_token");

	ЗагрузитьНастройкиИзВременногоФайла(НастройкиДокумента);

	ТекущиеНастройки = НастройкиOpm.ПолучитьНастройки();

	Ожидаем.Что(ТекущиеНастройки.ТокенПубликацииПакетов, "Токен публикации должен загрузиться в модель")
		.Равно("ghp_test_token");

КонецПроцедуры

Процедура ТестДолжен_ИгнорироватьНеизвестныйКорневойКлюч() Экспорт

	НастройкиДокумента = Новый Структура;
	НастройкиДокумента.Вставить("FutureSetting", 1);
	НастройкиДокумента.Вставить("СоздаватьShСкриптЗапуска", Истина);

	ЗагрузитьНастройкиИзВременногоФайла(НастройкиДокумента);

	ТекущиеНастройки = НастройкиOpm.ПолучитьНастройки();

	Ожидаем.Что(ТекущиеНастройки.СоздаватьShСкриптЗапуска, "Известный ключ должен загрузиться")
		.Равно(Истина);
	Ожидаем.Что(ТекущиеНастройки.Свойство("FutureSetting"), "Неизвестный ключ не должен попасть в модель")
		.Равно(Ложь);

КонецПроцедуры

Процедура ТестДолжен_ЗагрузитьИспользоватьАутентификациюОС() Экспорт

	НастройкиДокумента = Новый Структура;
	НастройкиПрокси = Новый Структура;
	НастройкиПрокси.Вставить("ИспользоватьПрокси", Ложь);
	НастройкиПрокси.Вставить("ИспользоватьАутентификациюОС", Истина);
	НастройкиДокумента.Вставить("Прокси", НастройкиПрокси);

	ЗагрузитьНастройкиИзВременногоФайла(НастройкиДокумента);

	ТекущиеНастройки = НастройкиOpm.ПолучитьНастройки();

	Ожидаем.Что(ТекущиеНастройки.НастройкиПрокси.ИспользоватьАутентификациюОС,
		"ИспользоватьАутентификациюОС должен загрузиться из файла")
		.Равно(Истина);

КонецПроцедуры

Процедура ТестДолжен_ЗагрузитьПортПроксиПоУмолчанию() Экспорт

	НастройкиДокумента = Новый Структура;
	НастройкиПрокси = Новый Структура;
	НастройкиПрокси.Вставить("Сервер", "proxy.example.com");
	НастройкиДокумента.Вставить("Прокси", НастройкиПрокси);

	ЗагрузитьНастройкиИзВременногоФайла(НастройкиДокумента);

	ТекущиеНастройки = НастройкиOpm.ПолучитьНастройки();

	Ожидаем.Что(ТекущиеНастройки.НастройкиПрокси.Порт, "Порт прокси по умолчанию должен быть 80")
		.Равно(80);

КонецПроцедуры

Процедура ТестДолжен_ОставитьПортСервераПакетовНеопределеннымЕслиПолеОтсутствует() Экспорт

	НастройкиДокумента = Новый Структура;
	СервераПакетов = Новый Массив;
	СервераПакетов.Добавить(Новый Структура("Имя, Сервер, ПутьНаСервере, РесурсПубликацииПакетов",
		"ТестовыйСервер", "http://packages.example.com", "/download/", "/push"));
	НастройкиДокумента.Вставить("СервераПакетов", СервераПакетов);

	ЗагрузитьНастройкиИзВременногоФайла(НастройкиДокумента);

	ТекущиеНастройки = НастройкиOpm.ПолучитьНастройки();
	НастройкаСервера = ТекущиеНастройки.СервераПакетов[0];

	Ожидаем.Что(НастройкаСервера.Порт, "Отсутствующий порт сервера пакетов должен остаться Неопределено")
		.Равно(Неопределено);

КонецПроцедуры

Процедура ТестДолжен_СоздатьВстроенныеСервераПакетовБезЯвногоПорта() Экспорт

	НастройкиOpm.СброситьНастройки();

	ТекущиеНастройки = НастройкиOpm.ПолучитьНастройки();

	Ожидаем.Что(ТекущиеНастройки.СервераПакетов[0].Порт, "Основной сервер по умолчанию не должен хранить явный порт")
		.Равно(Неопределено);
	Ожидаем.Что(ТекущиеНастройки.СервераПакетов[1].Порт, "Запасной сервер по умолчанию не должен хранить явный порт")
		.Равно(Неопределено);

КонецПроцедуры

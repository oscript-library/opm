#Использовать asserts
#Использовать tempfiles
#Использовать "../src/core"

Перем юТест;
Перем Хаб;
Перем Ответ;
Перем ФайлПакета;

// sha256 тела заглушки ответа «файл пакета» в UTF-8
Перем СуммаТела;

Функция ПолучитьСписокТестов(Знач Тестирование) Экспорт

	юТест = Тестирование;

	СписокТестов = Новый Массив;

	СписокТестов.Добавить("ТестДолжен_ПринятьФайлССовпавшейСуммой");
	СписокТестов.Добавить("ТестДолжен_ОтказатьПриРасхожденииСуммы");
	СписокТестов.Добавить("ТестДолжен_ПропуститьСверкуБезЗаголовка");

	Возврат СписокТестов;

КонецФункции

Процедура ПередЗапускомТеста() Экспорт

	СуммаТела = "4d7a8fcdfff25ff76d6eb81129d1f6d8b655e927458293b9f14062c9dd5b6117";

	Ответ = ЗагрузитьЗаглушку("ЗаглушкаОтветаХаба.os");
	Хаб = ЗагрузитьЗаглушку("ЗаглушкаСервераПакетов.os");
	Хаб.ОбъявитьПакет("vrunner");
	Хаб.Отвечать(Ответ);

	НастройкиOpm.СброситьНастройки();
	НастройкиOpm.ДобавитьСерверПакетов(Хаб);

	ФайлПакета = ВременныеФайлы.НовоеИмяФайла("ospx");

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт

	НастройкиOpm.СброситьНастройки();
	ВременныеФайлы.Удалить();

КонецПроцедуры

Процедура ТестДолжен_ПринятьФайлССовпавшейСуммой() Экспорт

	Ответ.Заголовки.Вставить("x-checksum-sha256", ВРег(СуммаТела));

	Скачать();

	Ожидаем.Что(Новый Файл(ФайлПакета).Существует(), "файл записан").ЭтоИстина();

КонецПроцедуры

Процедура ТестДолжен_ОтказатьПриРасхожденииСуммы() Экспорт

	Ответ.Заголовки.Вставить("X-Checksum-Sha256", СтрСоединить(Новый Массив(65), "0"));

	Попытка
		Скачать();
	Исключение
		Ожидаем.Что(ИнформацияОбОшибке().Описание, "причина отказа").Содержит("контрольная сумма файла " + СуммаТела);
		Ожидаем.Что(Новый Файл(ФайлПакета).Существует(), "файл не записан").ЭтоЛожь();
		Возврат;
	КонецПопытки;

	юТест.ПрерватьТест("Ожидали отказ при расхождении контрольной суммы");

КонецПроцедуры

Процедура ТестДолжен_ПропуститьСверкуБезЗаголовка() Экспорт

	Скачать();

	Ожидаем.Что(Новый Файл(ФайлПакета).Существует(), "файл записан").ЭтоИстина();

КонецПроцедуры

Процедура Скачать()
	МенеджерПолучения = Новый МенеджерПолученияПакетов();
	МенеджерПолучения.ПолучитьПакет("vrunner", Неопределено, ФайлПакета);
КонецПроцедуры

Функция ЗагрузитьЗаглушку(Знач ИмяФайла)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", ИмяФайла));
КонецФункции
